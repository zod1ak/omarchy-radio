{
  "schemaVersion": 1,
  "id": "zero.radio",
  "name": "Радио",
  "version": "2.0.0",
  "author": "zod1ak",
  "license": "MIT",
  "description": "Радио в панели Omarchy: избранное отдельно от списка станций, поиск, история",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
